# Application Configuration
PORT=5000
NODE_ENV=development # development, production, test
LOG_LEVEL=info # error, warn, info, http, verbose, debug, silly

# Database Configuration
DB_USER=your_db_user
DB_HOST=localhost
DB_DATABASE=autochalak_db
DB_PASSWORD=your_db_password
DB_PORT=5432
# DB_SSL=false # Set to true if using SSL for DB connection

# API Keys (if any, add later)
# SOME_API_KEY=your_api_key_here

# JWT Secrets
JWT_SECRET="your-default-super-secret-key-for-dev" # CHANGE THIS IN PRODUCTION!
JWT_EXPIRES_IN="1h" # Examples: "1h", "7d", "30m"
